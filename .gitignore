# =============================================================================
# StoryForge Monorepo .gitignore
# Covers: Next.js 16 (web/), Flutter 3.47 (app/), Node.js, Vercel, and OS files
# =============================================================================

# --- Environment & Secret Variables ---
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key

# --- Node.js & Next.js (web/) ---
node_modules/
.next/
out/
build/
dist/
.turbo/
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Flutter & Dart (app/) ---
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Generated JS/WASM
*.dart.js
*.info.json
*.js.deps
*.js.map
*.wasm

# Documentation
doc/api/

# Android Specific
app/android/.gradle/
app/android/local.properties
app/android/app/release/
app/android/app/debug/
*.keystore
*.jks

# iOS Specific
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/app.flx
app/ios/Flutter/app.zip
app/ios/Flutter/flutter_assets/
app/ios/ServiceDefinitions.json

# Windows / Linux / macOS desktop builds
app/build/
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/macos/Flutter/ephemeral/

# --- IDEs & System Files ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
