generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model World {
  id                 String   @id @default(uuid())
  name               String
  summary            String   @default("")
  themeNotes         String   @default("")
  worldBibleVersion  Int      @default(1)
  worldBibleHistory  Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  worldBible         WorldBible?
  rpgSystem          RpgSystem?
  stories            Story[]

  @@map("worlds")
}

model Story {
  id            String   @id
  title         String
  tagline       String
  synopsis      String
  genres        String[]
  language      String   @default("fa")
  coverImageUrl String?
  author        String   @default("StoryForge")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  published     Boolean  @default(false)
  manifest      Json     @default("{}")
  worldId       String?

  world         World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  // Legacy 1:1 links — kept for backwards compat during World 1:N transition.
  // New code resolves lore/RPG via Story.worldId -> World.
  worldBible    WorldBible? @relation("LegacyStoryWorldBible")
  rpgSystem     RpgSystem?  @relation("LegacyStoryRpgSystem")
  sessions      PlaythroughSession[]

  @@index([worldId])
  @@map("stories")
}

model WorldBible {
  id          String   @id @default(uuid())
  storyId     String?  @unique
  worldId     String?  @unique
  worldName   String
  summary     String
  themeNotes  String
  laws        Json     @default("[]")
  factions    Json     @default("[]")
  locations   Json     @default("[]")
  npcs        Json     @default("[]")
  timeline    Json     @default("[]")
  artifacts   Json     @default("[]")
  bestiary    Json     @default("[]")
  religions   Json     @default("[]")
  dramaBonds  Json     @default("[]")
  factionRelations Json @default("[]")
  ontology    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story?   @relation("LegacyStoryWorldBible", fields: [storyId], references: [id], onDelete: Cascade)
  world       World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("world_bibles")
}

model RpgSystem {
  id                 String   @id @default(uuid())
  storyId            String?  @unique
  worldId            String?  @unique
  hasCombat          Boolean  @default(true)
  diceType           String   @default("d20")
  inventoryCapacity  Int      @default(10)
  stats              Json     @default("[]")
  resources          Json     @default("[]")
  skills             Json     @default("[]")
  startingInventory  Json     @default("[]")
  archetypes         Json     @default("[]")
  backgrounds        Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  story              Story?   @relation("LegacyStoryRpgSystem", fields: [storyId], references: [id], onDelete: Cascade)
  world              World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("rpg_systems")
}

enum UserRole {
  READER
  AUTHOR
  ADMIN
}

enum PurchaseStatus {
  COMPLETED
  PENDING
  REFUNDED
  FAILED
}

model User {
  id             String               @id @default(uuid())
  phoneNumber    String               @unique
  passwordHash   String
  name           String?
  role           UserRole             @default(READER)
  creditBalance  Int                  @default(15)
  phoneVerified  Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  sessions       PlaythroughSession[]
  creditLedgers  UserCreditLedger[]
  bazaarPurchases BazaarPurchase[]

  @@map("users")
}

model UserCreditLedger {
  id           String   @id @default(uuid())
  userId       String
  amount       Int
  balanceAfter Int
  reason       String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_credit_ledgers")
}

model BazaarPurchase {
  id             String         @id @default(uuid())
  userId         String
  sku            String
  token          String         @unique
  status         PurchaseStatus @default(COMPLETED)
  amountPaidRial Int            @default(0)
  creditsAwarded Int
  rawResponse    Json           @default("{}")
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sku])
  @@map("bazaar_purchases")
}

model CreditPackage {
  id                 String   @id @default(uuid())
  sku                String   @unique
  title              String
  titleEn            String?
  credits            Int
  priceToman         Int
  priceRial          Int      @default(0)
  originalPriceToman Int?
  discountPercent    Int?     @default(0)
  badge              String?
  description        String
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("credit_packages")
}

model PlaythroughSession {
  sessionId        String   @id
  userId           String?  @default("guest_user")
  storyId          String
  currentSceneId   String
  turnCount        Int      @default(1)
  playerState      Json
  currentChapterId String?
  sagaLedger       Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  turns            TurnHistory[]
  memories         MemoryLog[]

  @@index([userId])
  @@map("playthrough_sessions")
}

model TurnHistory {
  id               String   @id @default(uuid())
  sessionId        String
  turnNumber       Int
  sceneId          String
  playerActionText String
  actionStyle      String   @default("free_text")
  narrativeProse   String
  presentedChoices Json     @default("[]")
  resolution       Json?
  chapterNumber    Int?
  createdAt        DateTime @default(now())

  session          PlaythroughSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId, turnNumber])
  @@map("turn_history")
}

model MemoryLog {
  id             String   @id @default(uuid())
  sessionId      String
  category       String   @default("player")
  importance     Int      @default(5)
  summary        String
  detail         String?
  turnNumber     Int      @default(1)
  sceneId        String?
  chapterNumber  Int?
  entityIds      String[] @default([])
  tags           String[] @default([])
  createdAt      DateTime @default(now())

  session        PlaythroughSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId, importance])
  @@map("memory_logs")
}
