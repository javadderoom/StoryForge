generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Story {
  id            String   @id
  title         String
  tagline       String
  synopsis      String
  genres        String[]
  language      String   @default("fa")
  coverImageUrl String?
  author        String   @default("StoryForge")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  worldBible    WorldBible?
  rpgSystem     RpgSystem?
  sessions      PlaythroughSession[]

  @@map("stories")
}

model WorldBible {
  id          String   @id @default(uuid())
  storyId     String   @unique
  worldName   String
  summary     String
  themeNotes  String
  laws        Json     @default("[]")
  factions    Json     @default("[]")
  locations   Json     @default("[]")
  npcs        Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("world_bibles")
}

model RpgSystem {
  id                 String   @id @default(uuid())
  storyId            String   @unique
  hasCombat          Boolean  @default(true)
  diceType           String   @default("d20")
  inventoryCapacity  Int      @default(10)
  stats              Json     @default("[]")
  resources          Json     @default("[]")
  skills             Json     @default("[]")
  startingInventory  Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  story              Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("rpg_systems")
}

model PlaythroughSession {
  sessionId       String   @id
  userId          String   @default("guest_user")
  storyId         String
  currentSceneId  String
  turnCount       Int      @default(1)
  playerState     Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  turns           TurnHistory[]
  memories        MemoryLog[]

  @@map("playthrough_sessions")
}

model TurnHistory {
  id               String   @id @default(uuid())
  sessionId        String
  turnNumber       Int
  sceneId          String
  playerActionText String
  actionStyle      String   @default("free_text")
  narrativeProse   String
  presentedChoices Json     @default("[]")
  resolution       Json?
  createdAt        DateTime @default(now())

  session          PlaythroughSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId, turnNumber])
  @@map("turn_history")
}

model MemoryLog {
  id         String   @id @default(uuid())
  sessionId  String
  category   String   @default("player")
  importance Int      @default(5)
  summary    String
  turnNumber Int      @default(1)
  createdAt  DateTime @default(now())

  session    PlaythroughSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId, importance])
  @@map("memory_logs")
}
